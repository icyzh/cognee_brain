   "text": "{\n \"answer\": \"Payments moved to Postgres per\n    ADR-007. Platform owns it; ask Priya.\",\n \"evidence\": [\n   {\"source\": \"adr\",     \"ref\": \"ADR-007.md\"},\n   {\"source\": \"meeting\", \"ref\": \"MTG-0312\"},\n   {\"source\": \"ticket\",  \"ref\": \"TCK-142\"}],\n \"path\": [\n   [\"svc-payments\", \"affected_by\", \"ADR-007\"],\n   [\"ADR-007\", \"decided_in\", \"MTG-0312\"],\n   [\"MTG-0312\", \"attended_by\", \"priya\"],\n   [\"priya\", \"member_of\", \"platform\"]],\n \"warnings\": [\"ADR-003 superseded by ADR-007\"],\n \"grounded\": true\n}",
