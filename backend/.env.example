# Cognee Cloud (used by the app): tenant URL + API key from the dashboard's API Keys page
COGNEE_SERVICE_URL=
COGNEE_API_KEY=
COGNEE_DATASET=snow

# Our own model: P4 contradiction judge (direct OpenAI call) + the local-mode spike.
# Cognee Cloud uses its own hosted model and ignores these.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
LLM_API_KEY=
# audio/video → text before Cognee (images use LLM_MODEL's vision)
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
ENABLE_BACKEND_ACCESS_CONTROL=false
